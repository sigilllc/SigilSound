# Cloudflare static-assets headers, copied to the root of the built site by scripts/build-site.sh.
# The REPL page carries its own Content-Security-Policy (apps/Sigil.Sound.Repl/wwwroot/index.html); none is added here so
# the two cannot disagree.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=()

# Every file under _framework has its content hash in its name (dotnet.e0ijh3zhds.js, System.Private.CoreLib.acqhqif0l6.wasm),
# so a changed file is a new URL and the old one can be cached for good. The rest of the site keeps Cloudflare's default
# (revalidate with an ETag), so a redeploy shows at once.
/repl/_framework/*
  Cache-Control: public, max-age=31536000, immutable
