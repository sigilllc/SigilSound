@page "/"
@implements IDisposable
@inject ReplEngine Engine
@inject IJSRuntime JS

<PageTitle>Sigil.Sound REPL</PageTitle>

<div class="app">
    <header class="bar">
        <a class="brand" href="https://sigilaud.io" target="_blank" rel="noopener noreferrer" title="Sigilgraph Audio Workbench">
            <img src="img/logo.svg" alt="" width="53" height="32" />
            <h1>
                <span class="wordmark">SIGIL.SOUND</span>
                <span class="tagline">REPL</span>
            </h1>
        </a>

        <div class="tpg">
            <button class="tp play" @onclick="RunAsync" disabled="@(!_ready)" aria-pressed="@(_playing ? "true" : "false")" title="Run (Ctrl+Enter)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3" /></svg>
                <span class="sr-only">Run</span>
            </button>
            <button class="tp" @onclick="Stop" disabled="@(!_playing)" title="Stop (Ctrl+.)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="1" /></svg>
                <span class="sr-only">Stop</span>
            </button>
        </div>

        <select class="sel" @onchange="LoadExampleAsync" value="" aria-label="Examples">
            <option value="" disabled>Examples</option>
            <optgroup label="Sigil.Sound">
                @foreach (var example in ReplExamples.All)
                {
                    <option value="@example.Name">@example.Name</option>
                }
            </optgroup>
            <optgroup label="Sigilgraph device scripts">
                @foreach (var example in SigilgraphExamples.All)
                {
                    <option value="@example.Name">@example.Name</option>
                }
            </optgroup>
        </select>

        <label class="switch" title="While a sound plays, apply edits as soon as they compile">
            <input type="checkbox" checked="@_refreshOnChange" @onchange="ToggleRefreshAsync" />
            Refresh on change
        </label>

        <label class="switch" title="Adds the Sound Script device's API (Knob, Slider, In, Out, Poly), simulated here, so scripts written for the Sigilgraph Audio Workbench run on this page">
            <input type="checkbox" checked="@_sigilgraph" @onchange="ToggleSigilgraphAsync" />
            Sigilgraph mode
        </label>

        <span class="sp"></span>

        <a class="btn" href="https://sigilaud.io" target="_blank" rel="noopener noreferrer"
           title="Sigilgraph Audio Workbench, the modular audio workstation this library comes from">To AudioWorkbench...</a>

        <button class="btn ghost" @onclick="ShareAsync" title="Copy a link that contains this snippet">Share</button>
        <button class="btn ghost" @onclick="DownloadAsync" disabled="@(!_ready)" title="Render 10 seconds to a WAV file">Export WAV</button>
        @* Placeholder until the repository is public. *@
        <a class="btn bare ic" aria-disabled="true" title="GitHub (not public yet)">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
        </a>
    </header>

    @if (_showDisclaimer)
    {
        <div class="disclaimer-banner" role="note" aria-label="Security and safety notice">
            <span class="disclaimer-badge">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Notice</span>
            </span>
            <span class="disclaimer-text">
                Snippets compile and run locally in your browser sandbox. Only execute code from sources you trust, and monitor volume levels to protect your hearing.
            </span>
            <button class="disclaimer-dismiss" @onclick="DismissDisclaimer" title="Dismiss notice" aria-label="Dismiss">✕</button>
        </div>
    }

    <main class="work">
        <div class="code">
            @if (_offerSigilgraph)
            {
                <div class="offer" role="status">
                    <span>This snippet uses the Sigilgraph device API (Knob, Slider, In, Out, Poly).</span>
                    <button class="btn" @onclick="EnterSigilgraphAsync">Switch to Sigilgraph mode</button>
                </div>
            }
            <div id="editor" class="editor" @ref="_editorHost"></div>
            @if (_showControls)
            {
                <ControlStrip Build="_build" />
            }
            @if (_usesKeys)
            {
                <PianoKeyboard Input="ReplApi.Keys" Active="_playing" />
            }
        </div>

        <div id="resizer" class="resizer" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0"></div>

        <aside class="side">
            <section class="sec">
                <div class="sec-h"><h2>Output</h2></div>
                <div class="wave"><canvas id="scope"></canvas></div>
            </section>

            <section class="sec" aria-live="polite">
                <div class="sec-h"><h2>Problems</h2><span class="end">@_diagnostics.Count</span></div>
                @if (_diagnostics.Count == 0)
                {
                    <p class="plain dim">None.</p>
                }
                else
                {
                    <ul class="problems">
                        @foreach (var d in _diagnostics.Take(8))
                        {
                            <li class="@(d.IsError ? "error" : "warning")">
                                @if (d.StartLine > 0)
                                {
                                    <span class="at">@d.StartLine:@d.StartColumn</span>
                                }
                                <span>@d.Message</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="sec">
                <div class="sec-h"><h2>Samples</h2><span class="end">@_samples.Count</span></div>
                <ul class="samples">
                    @foreach (var sample in _samples)
                    {
                        var name = sample.Name;
                        <li>
                            <span class="wf" aria-hidden="true"></span>
                            <button class="pick" title="Insert Samples.Load(&quot;@name&quot;) at the cursor" @onclick="() => InsertSampleAsync(name)">@name</button>
                            <span class="meta">@DescribeSample(sample)</span>
                            @if (sample.BuiltIn)
                            {
                                <span class="tag" title="Comes with the page. Drop a file with the same name to replace it.">built-in</span>
                            }
                            else
                            {
                                <button class="rm" aria-label="Remove @name" title="Remove @name" @onclick="() => RemoveSampleAsync(name)">✕</button>
                            }
                        </li>
                    }
                </ul>
                @if (_samples.All(s => s.BuiltIn))
                {
                    <p class="plain dim">Drop .wav files anywhere on this page to add your own, then play one with <code>Sample(Samples.Load("kick.wav"))</code>.</p>
                }
                <div class="sample-add">
                    <label class="btn ghost" for="sample-picker" title="Choose .wav files to add">Add .wav files</label>
                    <span class="plain dim">@(_samplesKept ? "Kept in this browser." : "Gone when you close this tab.")</span>
                </div>
            </section>

            <section class="sec">
                <div class="sec-h"><h2>Reference</h2></div>
                <ul class="kv">
                    <li><span class="k">Sources</span><span class="val">Sine Saw Square Noise Fn Constant</span></li>
                    <li><span class="k">Shape</span><span class="val">LowPass HighPass Adsr Range Gain Pan</span></li>
                    <li><span class="k">Space</span><span class="val">Delay Reverb Chorus Phaser</span></li>
                    <li><span class="k">Grit</span><span class="val">Distort BitCrush Comb Limit</span></li>
                    <li><span class="k">Mix</span><span class="val">a + b, a * 0.5</span></li>
                    <li><span class="k">Ring mod</span><span class="val">a * b</span></li>
                    <li><span class="k">Parameters</span><span class="val">number, sound, Fn(t =&gt; ...)</span></li>
                    <li><span class="k">Notes</span><span class="val">Notes.Parse("C4 E4"), LINQ</span></li>
                    <li><span class="k">Sequence</span><span class="val">.Every(Beats.Eighth).Loop().Play(v =&gt; ...)</span></li>
                    <li><span class="k">Keyboard</span><span class="val">Keys.Play(v =&gt; ...), Sigilgraph: Poly(8, v =&gt; ...)</span></li>
                    <li><span class="k">Samples</span><span class="val">Sample(Samples.Load("kick.wav"))</span></li>
                </ul>
                <p class="plain dim">The last expression is the sound.</p>
            </section>
        </aside>
    </main>

    <footer class="status">
        <span class="@_statusKind">@_status</span>
        <span class="sp"></span>
        <span class="keys"><span>Ctrl+Enter run</span><span>Ctrl+. stop</span><span>Ctrl+I suggest</span><span>Ctrl+Click docs</span></span>
    </footer>
</div>

@code {
    private ElementReference _editorHost;
    private DotNetObjectReference<Home>? _self;
    private DotNetObjectReference<ReplEngine>? _engineRef;
    private bool _ready;
    private bool _playing;
    private bool _refreshOnChange = true;
    private bool _showDisclaimer;
    private bool _disclaimerDismissed;
    private bool _usesKeys;
    private bool _sigilgraph;
    private bool _offerSigilgraph;
    private bool _showControls;
    private int _build;
    private bool _sigilgraphWarm;
    private bool _samplesKept;
    private IReadOnlyList<SampleEntry> _samples = [];
    private string _status = "Loading compiler";
    private string _statusKind = "dim";
    private IReadOnlyList<SnippetDiagnostic> _diagnostics = [];

    // Which snippet policy the page compiles with: the plain one, or the plain one plus the Sigilgraph device API.
    private SnippetProfile Profile => _sigilgraph ? SigilgraphProfile.Instance : ReplProfile.Instance;

    protected override void OnInitialized()
    {
        Engine.RenderFailed += OnRenderFailed;
        // Poly plays the keyboard under the editor, the same one Keys plays.
        SigilgraphSession.Instance.Keys = ReplApi.Keys;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _self = DotNetObjectReference.Create(this);
        _engineRef = DotNetObjectReference.Create(Engine);
        await JS.InvokeVoidAsync("sigilRepl.init", _self, _editorHost, ReplExamples.All[0].Code);
        UpdatePanels(await JS.InvokeAsync<string>("sigilRepl.getCode"));
        _refreshOnChange = await JS.InvokeAsync<bool>("sigilRepl.prefs.get", "refreshOnChange", true);
        // Samples from earlier visits go back into the virtual folder before any snippet can ask for them.
        _samplesKept = await JS.InvokeAsync<bool>("sigilRepl.samples.restore");
        RefreshSamples();
        _disclaimerDismissed = await JS.InvokeAsync<bool>("sigilRepl.prefs.get", "disclaimerDismissed", false);

        // Let the page paint before the first, slow Roslyn run.
        await Task.Delay(50);
        var timer = System.Diagnostics.Stopwatch.StartNew();
        await Task.Run(() =>
        {
            SnippetCompiler.Warm();
            EditorServices.Warm();
            // The page's own policy binds its own references; do that now rather than on the first keystroke.
            SnippetCompiler.Compile("Keys.Play(v => Sine(v.Frequency))", ReplProfile.Instance).Run();
            _ = EditorServices.Complete("Keys.", 5, ReplProfile.Instance);
        });
        _ready = true;
        SetStatus($"Ready ({timer.ElapsedMilliseconds} ms)", "dim");
    }

    private async Task DismissDisclaimer()
    {
        _showDisclaimer = false;
        _disclaimerDismissed = true;
        await JS.InvokeVoidAsync("sigilRepl.prefs.set", "disclaimerDismissed", true);
    }

    /// <summary>The editor saw a sizeable paste. The notice appears only then, so visitors who just type are not alarmed, and
    /// never again once dismissed.</summary>
    [JSInvokable]
    public void Pasted()
    {
        if (_disclaimerDismissed || _showDisclaimer) return;
        _showDisclaimer = true;
        StateHasChanged();
    }

    /// <summary>Run button and Ctrl+Enter: starts audio if needed and plays the editor's code.</summary>
    [JSInvokable]
    public async Task RunAsync()
    {
        if (!_ready)
            return;

        // Start audio first: this has to happen close to the click or key press that allowed it.
        await Engine.StartAsync(_engineRef!);
        var code = await JS.InvokeAsync<string>("sigilRepl.getCode");
        UpdatePanels(code);
        await PlayAsync(code);
    }

    /// <summary>
    /// Called after a pause in typing. With refresh on change, a playing sound is replaced as soon as
    /// the edit compiles; otherwise the code is only checked for problems.
    /// </summary>
    [JSInvokable]
    public async Task<IReadOnlyList<SnippetDiagnostic>> CodeChangedAsync(string code)
    {
        UpdatePanels(code);
        if (!_ready)
            return [];
        if (_refreshOnChange && _playing)
        {
            await PlayAsync(code);
            return _diagnostics;
        }

        _diagnostics = Engine.BeforeBlockingWork("analyze", () => SnippetCompiler.Check(code, Profile));
        StateHasChanged();
        return _diagnostics;
    }

    [JSInvokable]
    public void Stop()
    {
        Engine.Stop();
        _playing = false;
        SetStatus("Stopped", "dim");
    }

    [JSInvokable]
    public IReadOnlyList<CompletionItem> Complete(string code, int offset) =>
        _ready ? Engine.BeforeBlockingWork("analyze", () => EditorServices.Complete(code, offset, Profile)) : [];

    [JSInvokable]
    public string? Describe(string code, int offset) =>
        _ready ? Engine.BeforeBlockingWork("analyze", () => EditorServices.Describe(code, offset, Profile)) : null;

    [JSInvokable]
    public SignatureHelp? Signatures(string code, int offset) =>
        _ready ? Engine.BeforeBlockingWork("analyze", () => EditorServices.Signatures(code, offset, Profile)) : null;

    /// <summary>
    /// Asked before a dropped file is read into memory, so one that can never be kept (not a .wav, far too big) is refused
    /// without loading it. The reason goes to the status bar.
    /// </summary>
    [JSInvokable]
    public bool CanAddSample(string fileName, double size)
    {
        if (ReplSamples.CleanName(fileName) is null)
        {
            SetStatus($"\"{fileName}\" was not added: only .wav files can be used as samples.", "error");
            return false;
        }
        if (size > ReplSamples.MaxFileBytes)
        {
            SetStatus($"\"{fileName}\" was not added: it is {size / (1024 * 1024):0} MB and the limit is {ReplSamples.MaxFileBytes / (1024 * 1024)} MB.", "error");
            return false;
        }
        return true;
    }

    /// <summary>Keeps a dropped or picked .wav file in the virtual folder. The page stores a copy in the browser if this says it was kept.</summary>
    [JSInvokable]
    public SampleAddResult AddSample(string fileName, byte[] bytes)
    {
        var result = ReplSamples.Instance.Add(fileName, bytes);
        SetStatus(result.Message, result.Ok ? "ok" : "error");
        RefreshSamples();
        return result;
    }

    /// <summary>Puts back a sample saved by an earlier visit, without announcing it.</summary>
    [JSInvokable]
    public bool RestoreSample(string fileName, byte[] bytes) => ReplSamples.Instance.Restore(fileName, bytes);

    private void RefreshSamples()
    {
        _samples = ReplSamples.Instance.Entries();
        StateHasChanged();
    }

    private async Task RemoveSampleAsync(string name)
    {
        if (!ReplSamples.Instance.Remove(name))
            return;
        await JS.InvokeVoidAsync("sigilRepl.samples.forget", name);
        RefreshSamples();
        SetStatus($"Removed \"{name}\"", "dim");
    }

    private async Task InsertSampleAsync(string name) =>
        await JS.InvokeVoidAsync("sigilRepl.insertText", $"Samples.Load(\"{name}\")");

    private static string DescribeSample(SampleEntry sample)
    {
        string size = sample.Bytes >= 1024 * 1024 ? $"{sample.Bytes / (1024.0 * 1024):0.#} MB" : $"{Math.Max(1, sample.Bytes / 1024)} KB";
        return sample.Seconds > 0 ? $"{sample.Seconds:0.##} s, {size}" : size;
    }

    private async Task PlayAsync(string code)
    {
        SetStatus("Compiling", "dim");
        await Task.Delay(1);

        var timer = System.Diagnostics.Stopwatch.StartNew();
        var result = Engine.BeforeBlockingWork("compile", () => SnippetCompiler.Compile(code, Profile));
        long compileMs = timer.ElapsedMilliseconds;
        ShowDiagnostics(result.Diagnostics);

        if (!result.Success)
        {
            SetStatus(_playing ? "Not compiled; still playing the previous version" : "Not compiled", "error");
            return;
        }

        try
        {
            // In Sigilgraph mode running the snippet also declares its controls, which the strip below the editor then shows.
            var sound = _sigilgraph ? SigilgraphSession.Instance.Build(result.Run) : result.Run();
            if (_sigilgraph)
                _build++;
            Engine.Play(sound);
            _playing = true;
            SetStatus($"Playing (compiled in {compileMs} ms)", "ok");
        }
        catch (Exception e)
        {
            SetStatus($"{e.GetType().Name}: {e.Message}", "error");
        }
    }

    private async Task ToggleRefreshAsync(ChangeEventArgs e)
    {
        _refreshOnChange = e.Value is true;
        await JS.InvokeVoidAsync("sigilRepl.prefs.set", "refreshOnChange", _refreshOnChange);
    }

    private async Task LoadExampleAsync(ChangeEventArgs e)
    {
        string? name = e.Value as string;
        var example = ReplExamples.All.FirstOrDefault(x => x.Name == name);
        var device = SigilgraphExamples.All.FirstOrDefault(x => x.Name == name);
        example ??= device;
        if (example is null)
            return;

        // A device script only compiles in Sigilgraph mode, so picking one turns the mode on.
        if (device is not null && !_sigilgraph)
            await SetSigilgraphAsync(true);
        UpdatePanels(example.Code);
        // Refresh on change picks the new code up; without it, a playing sound switches right away.
        await JS.InvokeVoidAsync("sigilRepl.setCode", example.Code);
        if (_playing && !_refreshOnChange)
            await PlayAsync(example.Code);
    }

    private async Task ShareAsync()
    {
        bool copied = await JS.InvokeAsync<bool>("sigilRepl.share");
        SetStatus(copied ? "Link copied" : "Link is in the address bar", "dim");
    }

    private async Task DownloadAsync()
    {
        var code = await JS.InvokeAsync<string>("sigilRepl.getCode");
        var result = Engine.BeforeBlockingWork("compile", () => SnippetCompiler.Compile(code, Profile));
        ShowDiagnostics(result.Diagnostics);
        if (!result.Success)
        {
            SetStatus("Not compiled", "error");
            return;
        }

        try
        {
            using var wav = new MemoryStream();
            Engine.BeforeBlockingWork("render", () =>
            {
                result.Run().RenderToWav(wav, seconds: 10, sampleRate: Engine.SampleRate);
                return 0;
            });
            await JS.InvokeVoidAsync("sigilRepl.download", "sigil-sound.wav", wav.ToArray());
            SetStatus("Exported sigil-sound.wav (10 s)", "dim");
        }
        catch (Exception e)
        {
            SetStatus($"{e.GetType().Name}: {e.Message}", "error");
        }
    }

    // The keyboard is for snippets that use Keys (or Poly, in Sigilgraph mode); for any other it would do nothing. The controls strip
    // shares its place and shows for a snippet that uses the device API. A snippet typed in plain mode that uses the device API is offered the mode.
    private void UpdatePanels(string code)
    {
        bool keys = KeyboardUsage.Uses(code) || (_sigilgraph && SigilgraphUsage.UsesPoly(code));
        bool controls = _sigilgraph && SigilgraphUsage.UsesFaceplate(code);
        bool offer = !_sigilgraph && SigilgraphUsage.Uses(code);
        if (keys == _usesKeys && controls == _showControls && offer == _offerSigilgraph)
            return;
        _usesKeys = keys;
        _showControls = controls;
        _offerSigilgraph = offer;
        StateHasChanged();
    }

    private async Task ToggleSigilgraphAsync(ChangeEventArgs e) => await SetSigilgraphAsync(e.Value is true);

    private async Task EnterSigilgraphAsync() => await SetSigilgraphAsync(true);

    private async Task SetSigilgraphAsync(bool on)
    {
        if (on == _sigilgraph)
            return;
        _sigilgraph = on;
        if (!on)
            SigilgraphSession.Instance.Clear();

        if (on && !_sigilgraphWarm)
        {
            // The mode binds its own references; do that once now rather than on the first keystroke.
            SetStatus("Preparing Sigilgraph mode", "dim");
            await Task.Delay(1);
            await Task.Run(() =>
            {
                SnippetCompiler.Compile("Knob(\"Warm\", 1, 0, 2)", SigilgraphProfile.Instance);
                _ = EditorServices.Complete("Knob(", 5, SigilgraphProfile.Instance);
            });
            _sigilgraphWarm = true;
        }

        // The same text means something else under the other policy, so check it again.
        var code = await JS.InvokeAsync<string>("sigilRepl.getCode");
        UpdatePanels(code);
        if (_ready)
            ShowDiagnostics(Engine.BeforeBlockingWork("analyze", () => SnippetCompiler.Check(code, Profile)));
        SetStatus(on ? "Sigilgraph mode: Knob, Slider, In, Out and Poly are available" : "Plain mode", "dim");
    }

    private void ShowDiagnostics(IReadOnlyList<SnippetDiagnostic> diagnostics)
    {
        _diagnostics = diagnostics;
        ((IJSInProcessRuntime)JS).InvokeVoid("sigilRepl.setMarkers", diagnostics);
    }

    private void OnRenderFailed(string message)
    {
        _playing = false;
        SetStatus($"Stopped: {message}", "error");
    }

    private void SetStatus(string text, string kind)
    {
        _status = text;
        _statusKind = kind;
        // Calls from JavaScript (Ctrl+Enter, the audio pump) don't re-render on their own.
        StateHasChanged();
    }

    public void Dispose()
    {
        Engine.RenderFailed -= OnRenderFailed;
        _self?.Dispose();
        _engineRef?.Dispose();
    }
}
