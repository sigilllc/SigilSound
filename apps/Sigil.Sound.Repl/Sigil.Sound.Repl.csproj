<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- The browser REPL: type a C# expression, hear it. Everything runs client-side; there is no server. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Snippets can call anything in the referenced assemblies, which trimming can't see.
         Trimming with explicit roots is a later size optimization. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- A Release *build* (what `dotnet run -c Release` serves) still starts the browser runtime with the debugger enabled:
       the .NET interpreter keeps sequence points and skips optimizations, which made this DSP run roughly six times slower
       than the same code published. The audio renders on the page's only thread, so that was the difference between a
       busy arpeggio playing cleanly and breaking up after a few seconds. Release turns it off; Debug keeps it for debugging. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmDebugLevel>0</WasmDebugLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sigil.Sound.Repl.Core\Sigil.Sound.Repl.Core.csproj" />
  </ItemGroup>

  <!-- Samples that ship with the page (see BuiltInSamples). Embedded rather than served from wwwroot, so they are there
       the moment the runtime starts and need no request. -->
  <ItemGroup>
    <EmbeddedResource Include="Host\BuiltIn\*.wav" LogicalName="BuiltIn/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
