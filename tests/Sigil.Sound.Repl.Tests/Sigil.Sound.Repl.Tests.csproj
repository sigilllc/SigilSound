<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- The REPL page's own snippet API, profile and examples are plain C#, so they are compiled into the tests as source
       rather than by referencing the Blazor app: the page depends on the compiler, never the other way round. -->
  <ItemGroup>
    <Compile Include="..\..\apps\Sigil.Sound.Repl\Host\*.cs" LinkBase="Host" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\apps\Sigil.Sound.Repl.Core\Sigil.Sound.Repl.Core.csproj" />
    <ProjectReference Include="..\..\src\Sigil.Sound.Testing\Sigil.Sound.Testing.csproj" />
  </ItemGroup>
</Project>
