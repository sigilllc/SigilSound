{
  "metadata": [
    {
      "src": [
        { "src": "../src", "files": ["Sigil.Sound/Sigil.Sound.csproj", "Sigil.Sound.Notes/Sigil.Sound.Notes.csproj"] }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" },
      "outputFormat": "apiPage"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**/*.yml", "api/**/*.md"] },
      { "files": ["articles/**/*.md", "articles/**/toc.yml", "toc.yml", "index.md"] }
    ],
    "resource": [{ "files": ["images/**"] }],
    "output": "_site",
    "template": ["default", "modern", "templates/sigil"],
    "globalMetadata": {
      "_appName": "Sigil.Sound",
      "_appTitle": "Sigil.Sound",
      "_appFaviconPath": "logo.svg",
      "_appFooter": "Sigil.Sound is MIT licensed. Examples on these pages open in the browser REPL.",
      "_enableSearch": true
    }
  }
}
